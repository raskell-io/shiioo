# Shiioo environment configuration
# Copy to /etc/shiioo/shiioo.env and update values

# Required: 32-byte encryption key for secrets (AES-256)
# Generate with: openssl rand -base64 32 | head -c 32
SHIIOO_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY_HERE!!

# Logging
RUST_LOG=shiioo=info,tower_http=info
SHIIOO_LOG_JSON=false

# Rate limiting
SHIIOO_RATE_LIMIT_PER_SECOND=100
SHIIOO_RATE_LIMIT_BURST=200
